        "ECOMET_ENABLE_EXTENSION_ID_OVERRIDE": "1",
        "ECOMET_ALLOWED_EXTENSION_IDS": "kfdeggpflkbafbjdhbcmfgeibhdnmaio"
      }
    }
  }
}
