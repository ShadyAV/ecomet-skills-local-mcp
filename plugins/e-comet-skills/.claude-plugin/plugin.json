{
  "name": "e-comet-skills",
  "displayName": "e-Comet",
  "description": "Self-describing MCP tools for e-Comet analytics and live Wildberries data.",
  "repository": "https://github.com/e-comet/skills",
  "license": "Apache-2.0",
  "mcpServers": {
    "e-comet-local": {
      "type": "stdio",
      "command": "node",
